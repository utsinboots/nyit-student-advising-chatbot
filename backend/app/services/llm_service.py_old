"""
LLM Service for generative AI responses
Supports multiple LLM providers: OpenAI, Anthropic
"""

import os
import time
from typing import Dict, List, Optional
from openai import OpenAI
from app.config import settings

class LLMService:
    """Service for calling LLM APIs"""
    
    def __init__(self):
        """Initialize LLM clients"""
        self.openai_client = None
        self.claude_client = None
        
        # Initialize OpenAI client
        if settings.OPENAI_API_KEY:
            self.openai_client = OpenAI(api_key=settings.OPENAI_API_KEY)
        
        # Track usage for cost estimation
        self.total_input_tokens = 0
        self.total_output_tokens = 0
        self.total_calls = 0
    
    def generate_response(
        self,
        query: str,
        context: str = "",
        model: str = "gpt-4o-mini",
        max_tokens: int = 500,
        temperature: float = 0.7
    ) -> Dict:
        """
        Generate response using specified LLM
        
        Args:
            query: User's question
            context: Retrieved context from RAG (optional)
            model: LLM to use (gpt-5-mini, gpt-4o-mini, etc.)
            max_tokens: Maximum response length
            temperature: Response randomness (0-1)
        
        Returns:
            {
                'answer': str,
                'model_used': str,
                'tokens_used': {'input': int, 'output': int},
                'cost': float,
                'latency_ms': float
            }
        """
        
        if model.startswith("gpt") or model.startswith("o1"):
            return self._call_openai(query, context, model, max_tokens, temperature)
        elif model.startswith("claude"):
            return self._call_claude(query, context, model, max_tokens, temperature)
        else:
            raise ValueError(f"Unsupported model: {model}")
    
    def _call_openai(
        self,
        query: str,
        context: str,
        model: str,
        max_tokens: int,
        temperature: float
    ) -> Dict:
        """Call OpenAI API"""
        
        if not self.openai_client:
            raise ValueError("OpenAI API key not configured")
        
        # Build system prompt
        system_prompt = self._build_system_prompt()
        
        # Build user message with context
        user_message = self._build_user_message(query, context)
        
        # Make API call with timing
        start_time = time.time()
        
        try:
            response = self.openai_client.chat.completions.create(
                model=model,
                messages=[
                    {"role": "system", "content": system_prompt},
                    {"role": "user", "content": user_message}
                ],
                max_tokens=max_tokens,
                temperature=temperature
            )
            
            latency_ms = (time.time() - start_time) * 1000
            
            # Extract response
            answer = response.choices[0].message.content
            
            # Track usage
            input_tokens = response.usage.prompt_tokens
            output_tokens = response.usage.completion_tokens
            
            self.total_input_tokens += input_tokens
            self.total_output_tokens += output_tokens
            self.total_calls += 1
            
            # Calculate cost (approximate)
            cost = self._calculate_cost(model, input_tokens, output_tokens)
            
            return {
                'answer': answer,
                'model_used': model,
                'tokens_used': {
                    'input': input_tokens,
                    'output': output_tokens,
                    'total': input_tokens + output_tokens
                },
                'cost': cost,
                'latency_ms': latency_ms
            }
            
        except Exception as e:
            print(f"OpenAI API error: {e}")
            raise
    
    def _call_claude(
        self,
        query: str,
        context: str,
        model: str,
        max_tokens: int,
        temperature: float
    ) -> Dict:
        """Call Anthropic Claude API"""
        # TODO: Implement Claude integration
        # For now, return placeholder
        return {
            'answer': "Claude integration coming soon. Please use OpenAI models for now.",
            'model_used': model,
            'tokens_used': {'input': 0, 'output': 0, 'total': 0},
            'cost': 0.0,
            'latency_ms': 0.0
        }
    
    def _build_system_prompt(self) -> str:
        """Build system prompt for academic advisor chatbot"""
        return """You are an academic advisor chatbot for New York Institute of Technology (NYIT). 

Your role is to help students with:
- Academic advising questions
- Course registration and planning
- Degree requirements and policies
- Graduation planning
- General university information

Guidelines:
- Provide accurate, helpful information based on the context provided
- If you're not certain about specific policies or dates, advise students to verify with official sources
- Be concise but thorough
- Use a friendly, professional tone
- If information is not in the provided context, acknowledge this and suggest appropriate resources
- Always cite sources when referencing specific policies or requirements
- For time-sensitive information (deadlines, dates), remind students to check the current Academic Calendar

Remember: You're assisting students in making informed decisions about their academic journey."""
    
    def _build_user_message(self, query: str, context: str) -> str:
        """Build user message with optional context"""
        
        if context:
            return f"""Context from NYIT official sources:
{context}

Student Question: {query}

Please answer the student's question using the provided context. If the context doesn't fully answer the question, provide what information you can and suggest where the student should look for more details."""
        else:
            return f"""Student Question: {query}

Please answer the student's question about NYIT academic advising. Provide helpful information while acknowledging if you need more specific details from official sources."""
    
    def _calculate_cost(self, model: str, input_tokens: int, output_tokens: int) -> float:
        """Calculate approximate API cost"""
        
        # Pricing per 1M tokens (as of Dec 2024)
        pricing = {
            'gpt-5-mini': {'input': 0.25, 'output': 2.00},
            'gpt-4o-mini': {'input': 0.15, 'output': 0.60},
            'gpt-4o': {'input': 2.50, 'output': 10.00},
            'gpt-4-turbo': {'input': 10.00, 'output': 30.00},
        }
        
        # Default to gpt-5-mini pricing if model not found
        rates = pricing.get(model, pricing['gpt-5-mini'])
        
        input_cost = (input_tokens / 1_000_000) * rates['input']
        output_cost = (output_tokens / 1_000_000) * rates['output']
        
        return input_cost + output_cost
    
    def get_usage_stats(self) -> Dict:
        """Get cumulative usage statistics"""
        
        total_cost = 0.0
        if self.total_input_tokens > 0:
            # Use default pricing for estimate
            total_cost = self._calculate_cost(
                'gpt-5-mini',
                self.total_input_tokens,
                self.total_output_tokens
            )
        
        return {
            'total_calls': self.total_calls,
            'total_input_tokens': self.total_input_tokens,
            'total_output_tokens': self.total_output_tokens,
            'total_tokens': self.total_input_tokens + self.total_output_tokens,
            'estimated_cost': total_cost
        }
    
    def reset_usage_stats(self):
        """Reset usage statistics"""
        self.total_input_tokens = 0
        self.total_output_tokens = 0
        self.total_calls = 0