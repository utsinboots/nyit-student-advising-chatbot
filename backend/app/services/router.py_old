from typing import Dict, List, Optional
from enum import Enum


class RouteDecision(str, Enum):
    RULE_BASED = "rule_based"
    HYBRID = "hybrid"
    RAG_ONLY = "rag_only"
    LLM_WITH_RAG = "llm_with_rag"
    LLM_ONLY = "llm_only"


class QueryRouter:
    """
    Routes queries to appropriate module.

    Route meanings:
    - rule_based: High-confidence + simple -> use curated KB answer
    - hybrid: intent + RAG, no LLM
    - rag_only: retrieval-only answer, no LLM
    - llm_with_rag: LLM reasoning grounded with retrieved context
    - llm_only: LLM only (fallback when no good intent/RAG context)
    """

    def __init__(
        self,
        intent_threshold: float = 0.85,
        intent_weak_threshold: float = 0.70,
        rag_threshold: float = 0.70,
    ):
        self.intent_threshold = intent_threshold
        self.intent_weak_threshold = intent_weak_threshold
        self.rag_threshold = rag_threshold

    def route_query(self, query: str, intent_matches: List[Dict], rag_results: List[Dict]) -> Dict:
        """Determine how to handle the query."""

        top_intent_score: Optional[float] = intent_matches[0]["score"] if intent_matches else None
        top_rag_score: Optional[float] = rag_results[0]["score"] if rag_results else None

        has_strong_intent = bool(intent_matches) and (top_intent_score is not None) and (top_intent_score >= self.intent_threshold)
        has_weak_intent = bool(intent_matches) and (top_intent_score is not None) and (top_intent_score >= self.intent_weak_threshold)

        has_rag_context = bool(rag_results) and (top_rag_score is not None) and (top_rag_score >= self.rag_threshold)

        is_complex = self._is_complex_query(query)

        # --- Route 1: Strong intent + simple => RULE_BASED ---
        if has_strong_intent and not is_complex:
            return {
                "route": RouteDecision.RULE_BASED,
                "confidence": top_intent_score,
                "reasoning": "High-confidence intent match for a simple query",
                "use_intent": True,
                "use_rag": False,
                "use_llm": False,
                "intent_data": intent_matches[0],
                # debug fields
                "intent_score": top_intent_score,
                "rag_top_score": top_rag_score,
                "is_complex": is_complex,
            }

        # --- Route 2: Weak/medium intent + good RAG + simple => HYBRID (no LLM) ---
        if has_weak_intent and has_rag_context and not is_complex:
            return {
                "route": RouteDecision.HYBRID,
                "confidence": float((top_intent_score + top_rag_score) / 2),
                "reasoning": "Moderate intent match; augment response with RAG context (no LLM)",
                "use_intent": True,
                "use_rag": True,
                "use_llm": False,
                "intent_data": intent_matches[0],
                "rag_data": rag_results,
                # debug fields
                "intent_score": top_intent_score,
                "rag_top_score": top_rag_score,
                "is_complex": is_complex,
            }

        # --- Route 3: Complex + good RAG => LLM_WITH_RAG ---
        # Include intent if available (helps follow-ups, tone, and safer responses).
        if has_rag_context and is_complex:
            payload = {
                "route": RouteDecision.LLM_WITH_RAG,
                "confidence": top_rag_score if top_rag_score is not None else 0.5,
                "reasoning": "Complex query requiring LLM reasoning grounded with RAG context",
                "use_intent": bool(intent_matches),
                "use_rag": True,
                "use_llm": True,
                "rag_data": rag_results,
                # debug fields
                "intent_score": top_intent_score,
                "rag_top_score": top_rag_score,
                "is_complex": is_complex,
            }
            if intent_matches:
                payload["intent_data"] = intent_matches[0]
            return payload

        # --- Route 4: Good RAG + not complex => RAG_ONLY ---
        if has_rag_context:
            return {
                "route": RouteDecision.RAG_ONLY,
                "confidence": top_rag_score,
                "reasoning": "Sufficient RAG context available for a non-complex query",
                "use_intent": False,
                "use_rag": True,
                "use_llm": False,
                "rag_data": rag_results,
                # debug fields
                "intent_score": top_intent_score,
                "rag_top_score": top_rag_score,
                "is_complex": is_complex,
            }

        # --- Route 5: Fallback => LLM_ONLY ---
        return {
            "route": RouteDecision.LLM_ONLY,
            "confidence": 0.5,
            "reasoning": "No strong intent or RAG matches; using LLM-only fallback",
            "use_intent": False,
            "use_rag": False,
            "use_llm": True,
            # debug fields
            "intent_score": top_intent_score,
            "rag_top_score": top_rag_score,
            "is_complex": is_complex,
        }

    def _is_complex_query(self, query: str) -> bool:
        """Detect if query requires complex reasoning (heuristic)."""
        q = query.strip().lower()

        complex_keywords = [
            # your original list
            "explain", "why", "how does", "compare",
            "difference between", "which should i",
            "recommend", "best option", "what if",
            "multiple", "several", "both", "either",

            # additions for advising / decision-making
            "should i", "can i", "is it better", "pros and cons",
            "what do you recommend", "tradeoff", "advise", "depending on",
            "considering", "what happens if", "in my situation"
        ]

        for kw in complex_keywords:
            if kw in q:
                return True

        # multi-constraint / multi-part questions tend to be complex
        conjunctions = ["and", "or", "but", "if", "unless", "while"]
        conj_count = sum(q.split().count(c) for c in conjunctions)
        if conj_count >= 2:
            return True

        # length-based heuristic
        if len(q.split()) > 15 or q.count("?") > 1:
            return True

        return False
