        "expected_route": "rule_based"
    },
    {
        "query": "What are the graduation requirements?",
        "category": "Simple FAQ",
        "expected_route": "rule_based"
    },
    
    # Policy/Procedure (rag expected)
    {
        "query": "What is the policy for transferring credits?",
        "category": "Policy/Procedure",
        "expected_route": "rag"
    },
    {
        "query": "How do I apply for academic probation appeal?",
