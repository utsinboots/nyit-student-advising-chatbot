"""
Benchmark Script for AI Academic Advisor Chatbot
Focuses on key metrics: Latency, Cost, Accuracy
"""

import json
import time
import requests
from datetime import datetime
from pathlib import Path

# Configuration
API_URL = "http://localhost:8000"
RESULTS_DIR = Path("results")
RESULTS_DIR.mkdir(exist_ok=True)

# OpenAI API Pricing (adjust if using different models)
PRICING = {
    "gpt-4o-mini": {
        "input": 0.00015 / 1000,   # $0.150 per 1M tokens
        "output": 0.0006 / 1000,   # $0.600 per 1M tokens
    },
    "gpt-3.5-turbo": {
        "input": 0.0005 / 1000,    # $0.50 per 1M tokens
        "output": 0.0015 / 1000,   # $1.50 per 1M tokens
    },
    "gpt-4": {
        "input": 0.03 / 1000,      # $30 per 1M tokens
        "output": 0.06 / 1000,     # $60 per 1M tokens
    },
    "gpt-4-turbo": {
        "input": 0.01 / 1000,      # $10 per 1M tokens
        "output": 0.03 / 1000,     # $30 per 1M tokens
    },
    "gpt-4o": {
        "input": 0.0025 / 1000,    # $2.50 per 1M tokens
        "output": 0.01 / 1000,     # $10 per 1M tokens
    }
}

# Test queries organized by category
