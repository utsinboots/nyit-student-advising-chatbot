    # Simple FAQ (rule_based expected)
    {
        "query": "What are your office hours?",
        "category": "Simple FAQ",
        "expected_route": "rule_based"
    },
    {
        "query": "How do I contact advising?",
        "category": "Simple FAQ",
        "expected_route": "rule_based"
    },
    {
